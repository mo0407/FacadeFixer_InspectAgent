{
  "schema_version": "model-gateway-v1",
  "api_enabled": false,
  "connections": {
    "image_inspector": {
      "adapter": "mock",
      "model": "mock-image-inspector",
      "supports_images": true,
      "max_output_tokens": 8000
    },
    "offline_reflector": {
      "adapter": "mock",
      "model": "mock-reflector"
    },
    "offline_curator": {
      "adapter": "mock",
      "model": "mock-curator"
    }
  },
  "roles": {
    "generator": "image_inspector",
    "reflector": "offline_reflector",
    "curator": "offline_curator"
  }
}
