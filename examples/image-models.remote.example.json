{
  "schema_version": "model-gateway-v1",
  "api_enabled": false,
  "connections": {
    "image_inspector": {
      "adapter": "responses",
      "model": "gpt-6.1-sol",
      "expected_model": "gpt-6.1-sol",
      "reasoning_effort": "medium",
      "endpoint_env": "FACADE_IMAGE_ENDPOINT",
      "api_key_env": "FACADE_IMAGE_API_KEY",
      "supports_images": true,
      "timeout_seconds": 90,
      "max_output_tokens": 8000
    }
  },
  "roles": {
    "generator": "image_inspector",
    "reflector": "image_inspector",
    "curator": "image_inspector"
  }
}
